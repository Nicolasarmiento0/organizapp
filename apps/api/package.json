    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@better-auth/expo": "^1.2.5",
    "@organiza/shared": "*",
    "better-auth": "^1.2.5",
    "drizzle-orm": "^0.38.3",
    "hono": "^4.7.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.2",
    "wrangler": "^3.109.0"
  }
}
